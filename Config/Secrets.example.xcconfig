// Copy this file to Secrets.xcconfig (gitignored) and replace the value with the
// "API Read Access Token" from https://www.themoviedb.org/settings/api
//
// CI writes the same file from a secret before building, for example:
//   echo "TMDB_READ_ACCESS_TOKEN = $TMDB_READ_ACCESS_TOKEN" > Config/Secrets.xcconfig
TMDB_READ_ACCESS_TOKEN = your-read-access-token
